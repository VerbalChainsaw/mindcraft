diff --git a/node_modules/mineflayer/lib/container_open_gate.js b/node_modules/mineflayer/lib/container_open_gate.js
new file mode 100644
index 0000000..b07cd65
--- /dev/null
+++ b/node_modules/mineflayer/lib/container_open_gate.js
@@ -0,0 +1,156 @@
+'use strict'
+
+const DEFAULT_RESPONSE_HORIZON_MS = 20000
+
+function operationError (message, name, code) {
+  const error = new Error(message)
+  error.name = name
+  error.code = code
+  return error
+}
+
+function abortError () {
+  return operationError(
+    'Container opening was interrupted before a usable window was established.',
+    'AbortError',
+    'CONTAINER_OPEN_ABORTED'
+  )
+}
+
+function timeoutError (timeoutMs) {
+  return operationError(
+    `Container window did not open within ${Math.round(timeoutMs)}ms.`,
+    'TimeoutError',
+    'CONTAINER_OPEN_TIMEOUT'
+  )
+}
+
+function quarantinedError () {
+  return operationError(
+    'A previous container activation is still awaiting or disposing of its server response.',
+    'ContainerOpenQuarantinedError',
+    'CONTAINER_OPEN_QUARANTINED'
+  )
+}
+
+class ContainerOpenGate {
+  constructor (bot, {
+    responseHorizonMs = DEFAULT_RESPONSE_HORIZON_MS,
+    closeLateWindow = () => {}
+  } = {}) {
+    this.bot = bot
+    this.responseHorizonMs = Math.max(1, Number(responseHorizonMs) || DEFAULT_RESPONSE_HORIZON_MS)
+    this.closeLateWindow = closeLateWindow
+    this.generation = 0
+    this.active = null
+  }
+
+  get isQuarantined () {
+    return Boolean(this.active?.publicSettled)
+  }
+
+  open (activate, { signal, timeoutMs = this.responseHorizonMs } = {}) {
+    if (typeof activate !== 'function') {
+      return Promise.reject(new TypeError('Container activation must be a function.'))
+    }
+    if (this.active) return Promise.reject(quarantinedError())
+    if (signal?.aborted) return Promise.reject(abortError())
+
+    const publicTimeoutMs = Math.max(
+      1,
+      Math.min(this.responseHorizonMs, Number(timeoutMs) || this.responseHorizonMs)
+    )
+    const operation = {
+      generation: ++this.generation,
+      publicSettled: false,
+      publicTimer: null,
+      horizonTimer: null,
+      signal,
+      onAbort: null,
+      onWindowOpen: null,
+      resolve: null,
+      reject: null
+    }
+
+    const publicPromise = new Promise((resolve, reject) => {
+      operation.resolve = resolve
+      operation.reject = reject
+    })
+
+    const isCurrent = () => this.active === operation && this.active?.generation === operation.generation
+    const settlePublic = (method, value) => {
+      if (operation.publicSettled) return
+      operation.publicSettled = true
+      if (operation.publicTimer) {
+        clearTimeout(operation.publicTimer)
+        operation.publicTimer = null
+      }
+      signal?.removeEventListener?.('abort', operation.onAbort)
+      operation[method](value)
+    }
+    const release = () => {
+      if (!isCurrent()) return
+      if (operation.publicTimer) clearTimeout(operation.publicTimer)
+      if (operation.horizonTimer) clearTimeout(operation.horizonTimer)
+      signal?.removeEventListener?.('abort', operation.onAbort)
+      this.bot.removeListener('windowOpen', operation.onWindowOpen)
+      this.active = null
+    }
+
+    operation.onAbort = () => {
+      if (!isCurrent()) return
+      // The action may settle immediately, but the channel remains owned by
+      // this generation until its response arrives or the server horizon ends.
+      settlePublic('reject', abortError())
+    }
+    operation.onWindowOpen = (window) => {
+      if (!isCurrent()) return
+      if (!operation.publicSettled) {
+        settlePublic('resolve', window)
+        release()
+        return
+      }
+
+      // A response for an aborted/timed-out activation cannot become a usable
+      // window. Keep the channel quarantined until disposal has completed.
+      Promise.resolve()
+        .then(() => this.closeLateWindow(window))
+        .catch(() => {})
+        .finally(release)
+    }
+
+    this.active = operation
+    this.bot.on('windowOpen', operation.onWindowOpen)
+    signal?.addEventListener?.('abort', operation.onAbort, { once: true })
+
+    if (publicTimeoutMs < this.responseHorizonMs) {
+      operation.publicTimer = setTimeout(() => {
+        if (isCurrent()) settlePublic('reject', timeoutError(publicTimeoutMs))
+      }, publicTimeoutMs)
+    }
+    operation.horizonTimer = setTimeout(() => {
+      if (!isCurrent()) return
+      settlePublic('reject', timeoutError(publicTimeoutMs))
+      release()
+    }, this.responseHorizonMs)
+
+    try {
+      const activation = activate()
+      Promise.resolve(activation).catch(error => {
+        if (!isCurrent()) return
+        settlePublic('reject', error)
+        release()
+      })
+    } catch (error) {
+      settlePublic('reject', error)
+      release()
+    }
+
+    return publicPromise
+  }
+}
+
+module.exports = {
+  ContainerOpenGate,
+  DEFAULT_RESPONSE_HORIZON_MS
+}
