{
  "name": "MindcraftBot",
  "model": [
    { "api": "openai", "model": "gpt-4.1", "params": { "timeout": 12 } },
    { "api": "openai", "model": "gpt-4.1-mini", "params": { "timeout": 10 } }
  ],
  "reasoning_model": {
    "api": "openai",
    "model": "gpt-5",
    "params": { "timeout": 25 }
  },
  "autonomy_model": [
    { "api": "openai", "model": "gpt-4.1", "params": { "timeout": 12 } },
    { "api": "openai", "model": "gpt-4.1-mini", "params": { "timeout": 10 } }
  ],
  "memory_model": {
    "api": "openai",
    "model": "gpt-4.1-mini",
    "params": { "timeout": 15 }
  },
  "cooldown": 350,
  "runtime": {
    "role": "companion",
    "autonomy": "autonomous",
    "traversal": "full",
    "limits": { "maxPromptTurns": 2 },
    "reflexes": { "combat": "defend" },
    "survival": {
      "mode": "full",
      "eatAt": 14,
      "criticalFood": 6,
      "reserveFoodPoints": 12,
      "sleep": "safe",
      "shelter": "emergency",
      "armor": "upgrade",
      "usefulDrops": "collect"
    },
    "jobs": { "mode": "resumable" },
    "reactions": { "mode": "natural", "maxSpeechPerMinute": 4, "maxGesturesPerMinute": 8 },
    "memory": { "personal": true, "team": "off" }
  },
  "modes": {
    "self_preservation": true,
    "unstuck": true,
    "cowardice": false,
    "self_defense": true,
    "hunting": true,
    "item_collecting": true,
    "torch_placing": true,
    "elbow_room": true,
    "idle_staring": true,
    "cheat": false
  },
  "conversation_examples": [
    [
      { "role": "user", "content": "DirectorTest: Come here." },
      { "role": "assistant", "content": "Coming. !come(\"DirectorTest\")" }
    ],
    [
      { "role": "user", "content": "DirectorTest: Follow me." },
      { "role": "assistant", "content": "Following. !follow(\"DirectorTest\")" }
    ],
    [
      { "role": "user", "content": "DirectorTest: Stay here." },
      { "role": "assistant", "content": "Staying here. !stay(-1)" }
    ],
    [
      { "role": "user", "content": "DirectorTest: Get five oak logs." },
      { "role": "assistant", "content": "I will collect five oak logs. !collect(\"oak_log\", 5)" }
    ],
    [
      { "role": "user", "content": "DirectorTest: Give me the logs." },
      { "role": "assistant", "content": "I will give you the logs I am carrying. !giveFamilyToPlayer(\"logs\", \"DirectorTest\", 64)" }
    ],
    [
      { "role": "user", "content": "DirectorTest: Protect me." },
      { "role": "assistant", "content": "I will clear nearby hostile mobs. !defend(\"DirectorTest\")" }
    ],
    [
      { "role": "user", "content": "DirectorTest: Put down three torches." },
      { "role": "assistant", "content": "I will place three torches nearby. !place(\"DirectorTest\", \"torch\", 3)" }
    ]
  ]
}
