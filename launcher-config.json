{
  "mindserver_port": 8081,
  "mindserver_host_public": false,
  "auto_open_ui": false,
  "auto_start": true,
  "port_scan_start": 8081,
  "port_scan_max": 20,
  "profiles": [
    "./profiles/local-quickstart.json"
  ],
  "agent_defaults": {
    "host": "127.0.0.1",
    "port": 25579,
    "auth": "offline",
    "minecraft_version": "auto",
    "base_profile": "assistant",
    "model": "",
    "init_message": "Respond with hello world and your name",
    "load_memory": true,
    "speak": false,
    "chat_ingame": true,
    "allow_vision": false,
    "render_bot_view": false
  },
  "telemetry": {
    "intervalMs": 2500,
    "requestTimeoutMs": 1200,
    "maxConcurrent": 6,
    "heartbeatMs": 2500,
    "failureBackoffMs": 1500,
    "maxFailureBackoffMs": 15000
  }
}
